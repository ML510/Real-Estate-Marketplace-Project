generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id String @id @default(cuid())

  title String
  description String

  propertyType String
  listingType String

  price Int

  bedrooms Int
  bathrooms Int
  parkingSpaces Int
  area Int?

  location String
  address String

  image String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  // owner User @relation(fiel: [ownerId], references: [id], onDelete: Cascade)
}